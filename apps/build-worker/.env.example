# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
SQS_QUEUE_URL=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vercel_clone

# GitHub (resolved at runtime via primary-backend API)
GIT_TOKEN_SHARMAN=

# Env Variable Encryption
# REQUIRED — must match the same ENV_ENCRYPTION_SECRET set on the primary-backend.
# The build-worker does NOT decrypt env vars itself; they arrive pre-decrypted
# in the SQS BuildJob payload. This key is here for documentation consistency.
ENV_ENCRYPTION_SECRET=
